/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding-bottom: 20rpx;
}

/* 顶部标题 */
.header-section {
  background-color: #fff;
  padding: 30rpx;
  text-align: center;
}

.app-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  letter-spacing: 2rpx;
}

/* 圆形分类导航 */
.category-section {
  background-color: #fff;
  padding: 20rpx 0;
  margin-bottom: 2rpx;
}

.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  padding: 0 20rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 20rpx;
  min-width: 140rpx;
}

.avatar-wrapper {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
  padding: 6rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.category-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
}

.category-text {
  font-size: 24rpx;
  color: #666;
  text-align: center;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-item:active .avatar-wrapper {
  transform: scale(0.95);
}

/* 风格合集标题 */
.style-collection-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
  background-color: #fff;
  margin-bottom: 2rpx;
}

.header-left {
  display: flex;
  align-items: center;
}

.title-bar {
  width: 8rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #d4a574 0%, #c4956a 100%);
  margin-right: 12rpx;
  border-radius: 4rpx;
}

.collection-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.arrow-right {
  font-size: 40rpx;
  color: #ccc;
}

/* 作品网格 */
.works-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15rpx;
  padding: 15rpx;
}

.work-card {
  position: relative;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  aspect-ratio: 3 / 4;
}

.work-image {
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
}

.work-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 80rpx 20rpx 20rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 60%);
  color: #fff;
}

.work-title-row {
  margin-bottom: 8rpx;
}

.work-title {
  font-size: 28rpx;
  font-weight: 500;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.work-subtitle {
  font-size: 22rpx;
  opacity: 0.9;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

/* 关注按钮 */
.follow-btn {
  position: absolute;
  right: 20rpx;
  bottom: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.heart-icon {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.follow-text {
  font-size: 18rpx;
  color: #666;
}

.follow-btn:active {
  transform: scale(0.9);
}

/* 预约按钮 */
.quick-book-btn {
  position: absolute;
  right: 20rpx;
  bottom: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  background: linear-gradient(135deg, #5bc1de 0%, #4ab3d0 100%);
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(91, 193, 222, 0.4);
}

.book-icon {
  font-size: 24rpx;
  color: #fff;
  margin-bottom: 4rpx;
}

.book-text {
  font-size: 18rpx;
  color: #fff;
}

.quick-book-btn:active {
  transform: scale(0.9);
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx;
  color: #999;
  font-size: 28rpx;
}
