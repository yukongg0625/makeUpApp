/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding-bottom: 20rpx;
}

/* 顶部标题 */
.header-section {
  background-color: #fff;
  padding: 30rpx;
  text-align: center;
  position: relative;
}

.app-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  letter-spacing: 2rpx;
  line-height: 1.4;
}

/* 功能集横向导航 */
.feature-section {
  background-color: #fff;
  padding: 20rpx 0;
  margin-bottom: 2rpx;
}

.feature-scroll {
  white-space: nowrap;
}

.feature-list {
  display: inline-flex;
  padding: 0 20rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 20rpx;
  min-width: 140rpx;
}

.feature-cover {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  object-fit: cover;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  border: 2rpx solid #fff;
  outline: 3rpx solid #d4a574;
  outline-offset: 2rpx;
}

.feature-text {
  font-size: 24rpx;
  color: #666;
  text-align: center;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-item:active .feature-cover {
  transform: scale(0.95);
}

/* 精华相册标题 */
.featured-section {
  background-color: #fff;
  margin-bottom: 2rpx;
  padding-bottom: 20rpx;
}

.featured-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.featured-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  position: relative;
  padding-left: 20rpx;
}

.featured-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 36rpx;
  background: linear-gradient(180deg, #d4a574 0%, #c4956a 100%);
  border-radius: 4rpx;
}

.arrow-right {
  font-size: 40rpx;
  color: #ccc;
}

/* 精华相册网格 */
.featured-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15rpx;
  padding: 15rpx;
}

.featured-item {
  position: relative;
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  aspect-ratio: 3 / 4;
}

.featured-image {
  width: 100%;
  height: 100%;
  background-color: #f5f5f5;
  object-fit: cover;
}

.featured-item text {
  position: absolute;
  bottom: 20rpx;
  left: 20rpx;
  right: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 100%);
  padding-top: 60rpx;
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx;
  color: #999;
  font-size: 28rpx;
}
