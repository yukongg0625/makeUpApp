<view class="container">
  <!-- 顶部标题 -->
  <view class="header-section">
    <text class="app-title">潘潘的美妝穿搭合集</text>
  </view>

  <!-- 横向导航栏 - 影集封面 -->
  <view class="feature-section">
    <scroll-view class="feature-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
      <view class="feature-list">
        <view 
          class="feature-item" 
          wx:for="{{features}}" 
          wx:key="_id"
          bindtap="onFeatureTap"
          data-id="{{item._id}}"
          data-name="{{item.name}}"
        >
          <image class="feature-cover" src="{{item.coverImage}}" mode="aspectFill" />
          <text class="feature-text">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 精华相册 -->
  <view class="featured-section">
    <view class="featured-header" bindtap="onViewFeatured">
      <text class="featured-title">精华相册</text>
      <text class="arrow-right">›</text>
    </view>
    <view class="featured-grid">
      <view 
          class="featured-item" 
          wx:for="{{featuredWorks}}" 
          wx:key="_id"
          bindtap="onWorkTap"
          data-id="{{item.workId}}"
        >
        <image class="featured-image" src="{{item.coverUrl}}" mode="aspectFill" lazy-load="{{true}}" />
        <text class="featured-title">{{item.title}}</text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">加载中...</view>
  <view class="empty-state" wx:if="{{!loading && featuredWorks.length === 0}}">
    <text>暂无作品</text>
  </view>
</view>
