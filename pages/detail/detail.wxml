<view class="container">
  <!-- 图片轮播 -->
  <view class="image-section">
    <swiper 
      class="image-swiper" 
      indicator-dots="{{images.length > 1}}"
      autoplay="{{false}}"
      current="{{currentImageIndex}}"
      bindchange="onImageChange"
    >
      <swiper-item wx:for="{{images}}" wx:key="*this">
        <image 
          class="detail-image" 
          src="{{item}}" 
          mode="aspectFit" 
          lazy-load="{{true}}"
          bindtap="onPreviewImage"
          data-index="{{index}}"
        />
      </swiper-item>
    </swiper>
    
    <!-- 图片计数 -->
    <view class="image-counter" wx:if="{{images.length > 1}}">
      {{currentImageIndex + 1}} / {{images.length}}
    </view>
  </view>

  <!-- 作品信息 -->
  <view class="info-section">
    <view class="title-row">
      <text class="work-title">{{workInfo.title}}</text>
      <view class="share-btn" bindtap="onShare">
        <text>分享</text>
      </view>
    </view>

    <view class="meta-row">
      <view class="tag-item" wx:if="{{workInfo.usageType}}">
        <text>{{workInfo.usageType}}</text>
      </view>
    </view>

    <view class="description" wx:if="{{workInfo.description}}">
      <text class="desc-content">{{workInfo.description}}</text>
    </view>
  </view>

  <!-- 右侧固定联系店家按钮 -->
  <view class="contact-shop-btn" bindtap="onContactShop">
    <text class="contact-icon">💬</text>
    <text>联系店家</text>
  </view>

  <!-- 自定义底部导航 -->
  <tab-bar currentTab="{{0}}"></tab-bar>
</view>
