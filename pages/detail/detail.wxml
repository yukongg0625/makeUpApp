<view class="container">
  <view class="image-section">
    <swiper 
      class="image-swiper" 
      indicator-dots="{{images.length > 1}}"
      autoplay="{{false}}"
      current="{{currentImageIndex}}"
      bindchange="onImageChange"
    >
      <swiper-item wx:for="{{images}}" wx:key="index">
        <image 
          class="detail-image" 
          src="{{item}}" 
          mode="aspectFit" 
          lazy-load="{{true}}"
          bindtap="onPreviewImage"
          data-index="{{index}}"
          binderror="onImageError"
          bindload="onImageLoad"
        />
      </swiper-item>
    </swiper>
    
    <view class="empty-state" wx:if="{{images.length === 0}}">
      <text>暂无图片</text>
    </view>
    
    <view class="image-counter" wx:if="{{images.length > 1}}">
      {{currentImageIndex + 1}} / {{images.length}}
    </view>
  </view>

  <view class="info-section">
    <view class="title-row">
      <text class="work-title">{{workInfo.title}}</text>
      <view class="share-btn" bindtap="onShare">
        <text>分享</text>
      </view>
    </view>

    <view class="meta-row">
      <view class="tag-item" wx:if="{{workInfo.usageType}}">
        <text>{{workInfo.usageType}}</text>
      </view>
    </view>

    <view class="description" wx:if="{{workInfo.description}}">
      <text class="desc-content">{{workInfo.description}}</text>
    </view>
  </view>

  <view class="contact-bubble" bindtap="onContactBubbleTap">
    <text class="contact-icon">💬</text>
    <text class="contact-text">联系我们</text>
  </view>

  <view class="favorite-bubble" bindtap="onFavoriteTap">
    <text class="favorite-icon">{{isFavorited ? '⭐' : '☆'}}</text>
    <text class="favorite-text">收藏</text>
  </view>

  <view class="contact-modal" wx:if="{{showContactModal}}" bindtap="onCloseContactModal">
    <view class="contact-modal-content" catchtap="stopPropagation">
      <view class="modal-title">联系客服</view>
      <view class="modal-info" wx:if="{{contactMessage}}">
        <text>已复制以下信息到剪贴板：</text>
        <text class="contact-message-text">{{contactMessage}}</text>
      </view>
      <view class="modal-actions">
        <button class="modal-btn-secondary" bindtap="onCloseContactModal">取消</button>
        <button class="modal-btn-primary" open-type="contact" bindcontact="onContactSessionEnd">直接联系</button>
        <button class="modal-btn-image" bindtap="onCopyImageAndContact">复制图片后联系</button>
      </view>
    </view>
  </view>

  <view class="login-modal" wx:if="{{loginModalVisible}}" bindtap="onCloseLoginModal">
    <view class="login-modal-content" catchtap="stopPropagation">
      <view class="login-icon">👤</view>
      <view class="login-title">需要登录</view>
      <view class="login-desc">请先登录后才能进行此操作</view>
      <view class="login-actions">
        <button class="login-btn-secondary" bindtap="onCloseLoginModal">取消</button>
        <button class="login-btn-primary" bindtap="onLogin">去登录</button>
      </view>
    </view>
  </view>

  <view class="custom-tab-bar">
    <view class="tab-bar">
      <view class="tab-item" bindtap="switchTab" data-page="/pages/index/index">
        <image class="tab-icon" src="/images/home.png" mode="aspectFit"></image>
        <text class="tab-text">主页</text>
      </view>
      <view class="tab-item" bindtap="onMiddleTabTap">
        <image class="tab-icon" src="/images/star.png" mode="aspectFit"></image>
        <text class="tab-text">{{middleTabText}}</text>
      </view>
      <view class="tab-item" bindtap="switchTab" data-page="/pages/contact/contact">
        <image class="tab-icon" src="/images/calendar.png" mode="aspectFit"></image>
        <text class="tab-text">联系我们</text>
      </view>
      <view class="tab-item" bindtap="switchTab" data-page="/pages/profile/profile">
        <image class="tab-icon" src="/images/profile.png" mode="aspectFit"></image>
        <text class="tab-text">我的</text>
      </view>
    </view>
  </view>
</view>