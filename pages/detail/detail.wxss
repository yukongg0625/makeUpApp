/* pages/detail/detail.wxss */
.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  position: relative;
}

.image-section {
  position: relative;
  width: 100%;
  background-color: #000;
}

.image-swiper {
  width: 100%;
  height: 100vh;
}

.detail-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.image-counter {
  position: absolute;
  bottom: 40rpx;
  right: 40rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #fff;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.info-section {
  background-color: #fff;
  margin-top: -40rpx;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 30rpx;
  padding-bottom: 140rpx;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.work-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.share-btn {
  padding: 10rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #666;
}

.meta-row {
  margin-bottom: 30rpx;
}

.tag-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  background-color: #f9f5f0;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #d4a574;
}

.description {
  margin-bottom: 30rpx;
  line-height: 1.8;
}

.desc-content {
  display: block;
  font-size: 30rpx;
  color: #666;
  line-height: 1.8;
}

.action-row {
  display: flex;
  gap: 40rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  font-size: 36rpx;
}

.action-text {
  font-size: 28rpx;
  color: #666;
}

.contact-bubble {
  position: fixed;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  z-index: 100;
  cursor: pointer;
}

.contact-icon {
  font-size: 40rpx;
  line-height: 1;
  margin-bottom: 6rpx;
}

.contact-text {
  font-size: 20rpx;
  color: #333;
  text-align: center;
  line-height: 1;
}

.contact-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-modal-content {
  width: 80%;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
}

.modal-info {
  display: flex;
  flex-direction: column;
  background-color: #f9f9f9;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.modal-info text {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.contact-message-text {
  font-size: 24rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 0;
}

.modal-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.modal-btn-secondary,
.modal-btn-primary,
.modal-btn-image {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 30rpx;
  border: none;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn-secondary {
  background-color: #f5f5f5;
  color: #666;
}

.modal-btn-primary {
  background-color: #07c160;
  color: #fff;
}

.modal-btn-image {
  background-color: #1989fa;
  color: #fff;
}

.modal-btn-secondary::after,
.modal-btn-primary::after,
.modal-btn-image::after {
  border: none;
}

.comments-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 300;
  display: flex;
  align-items: flex-end;
}

.comments-modal-content {
  width: 100%;
  background-color: #fff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.comments-list {
  flex: 1;
  padding: 20rpx 30rpx;
  max-height: 60vh;
}

.comment-item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #f5f5f5;
}

.comment-content {
  flex: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.comment-nickname {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.empty-comments {
  padding: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

.comment-input-area {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.comment-submit-btn {
  width: 120rpx;
  height: 72rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
  border: none;
  padding: 0;
  margin: 0;
}

.comment-submit-btn::after {
  border: none;
}

.login-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 400;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-modal-content {
  width: 70%;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
}

.login-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.login-desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.login-actions {
  display: flex;
  gap: 20rpx;
}

.login-btn-secondary,
.login-btn-primary {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 40rpx;
  font-size: 30rpx;
  border: none;
  padding: 0;
  margin: 0;
}

.login-btn-secondary {
  background-color: #f5f5f5;
  color: #666;
}

.login-btn-primary {
  background-color: #07c160;
  color: #fff;
}

.login-btn-secondary::after,
.login-btn-primary::after {
  border: none;
}

.custom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #ffffff;
  border-top: 1rpx solid #e0e0e0;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}

.tab-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  height: 100%;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 6rpx;
}

.tab-text {
  font-size: 22rpx;
  color: #999999;
}