/* pages/detail/detail.wxss */
.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding-bottom: 140rpx;
}

/* 图片区域 */
.image-section {
  position: relative;
  width: 100%;
  background-color: #000;
}

.image-swiper {
  width: 100%;
  height: 100vh;
}

.detail-image {
  width: 100%;
  height: 100%;
}

.image-counter {
  position: absolute;
  bottom: 40rpx;
  right: 40rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #fff;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 信息区域 */
.info-section {
  background-color: #fff;
  margin-top: -40rpx;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 30rpx;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.work-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.share-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #666;
}

.share-icon {
  font-size: 32rpx;
  margin-bottom: 4rpx;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background-color: #f9f5f0;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #d4a574;
}

.tag-icon {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.description {
  margin-bottom: 30rpx;
  line-height: 1.8;
}

.desc-label {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.desc-content {
  display: block;
  font-size: 30rpx;
  color: #666;
  line-height: 1.8;
}

.detail-list {
  margin-top: 20rpx;
}

.detail-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.detail-dot {
  color: #d4a574;
  margin-right: 12rpx;
  font-size: 30rpx;
}

.detail-text {
  flex: 1;
  font-size: 28rpx;
  color: #666;
}

/* 操作区域 */
.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
  gap: 20rpx;
}

.contact-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  padding: 16rpx;
  background-color: #f5f5f5;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #666;
}

.btn-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}

.booking-btn {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 88rpx;
  background: linear-gradient(135deg, #d4a574 0%, #c4956a 100%);
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(212, 165, 116, 0.4);
}

.btn-arrow {
  margin-left: 12rpx;
  font-size: 36rpx;
}
