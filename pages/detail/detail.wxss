/* pages/detail/detail.wxss */
.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  position: relative;
}

/* 图片区域 */
.image-section {
  position: relative;
  width: 100%;
  background-color: #000;
}

.image-swiper {
  width: 100%;
  height: 100vh;
}

.detail-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.image-counter {
  position: absolute;
  bottom: 40rpx;
  right: 40rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #fff;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 信息区域 */
.info-section {
  background-color: #fff;
  margin-top: -40rpx;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 30rpx;
  padding-bottom: 140rpx;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.work-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.share-btn {
  padding: 10rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #666;
}

.meta-row {
  margin-bottom: 30rpx;
}

.tag-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  background-color: #f9f5f0;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #d4a574;
}

.description {
  margin-bottom: 30rpx;
  line-height: 1.8;
}

.desc-content {
  display: block;
  font-size: 30rpx;
  color: #666;
  line-height: 1.8;
}

/* 右侧固定联系店家按钮 */
.contact-shop-btn {
  position: fixed;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  background-color: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  z-index: 100;
}

.contact-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.contact-shop-btn text {
  font-size: 20rpx;
  color: #333;
  text-align: center;
}
