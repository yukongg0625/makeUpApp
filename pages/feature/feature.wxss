/* pages/feature/feature.wxss */
.container {
  position: relative;
  min-height: 100vh;
  background-color: #f8f8f8;
  display: flex;
}

/* 侧边栏 - 固定显示 */
.sidebar {
  position: fixed;
  left: 0;
  top: 0;
  width: 130rpx;
  height: 100vh;
  background-color: #ffffff;
  box-shadow: 2rpx 0 10rpx rgba(0, 0, 0, 0.1);
  z-index: 100;
  display: flex;
  flex-direction: column;
}

.sidebar-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background-color: #f9f9f9;
}

.sidebar-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  text-align: center;
}

.sidebar-list {
  flex: 1;
  overflow-y: auto;
  padding: 10rpx 0;
}

.sidebar-item {
  padding: 25rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  text-align: center;
}

.sidebar-item.active {
  background-color: #f5f5f5;
}

.sidebar-item text {
  font-size: 22rpx;
  color: #666666;
}

.sidebar-item.active text {
  color: #d4a574;
  font-weight: bold;
}

/* 主内容区 */
.main-content {
  flex: 1;
  margin-left: 130rpx;
  padding-top: 20rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

/* 作品列表 */
.works-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 20rpx;
}

.work-item {
  background-color: #ffffff;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.work-image {
  width: 100%;
  height: 300rpx;
  display: block;
}

.work-info {
  padding: 20rpx;
}

.work-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
  display: block;
}

.work-subtitle {
  font-size: 24rpx;
  color: #999999;
  display: block;
}

/* 加载中 */
.loading {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: rgba(0, 0, 0, 0.5);
  color: #ffffff;
  padding: 20rpx 40rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
}
