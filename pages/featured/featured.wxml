<view class="container">
  <!-- 精选作品网格 -->
  <view class="featured-grid">
    <view class="featured-row" wx:for="{{featuredRows}}" wx:key="index">
      <view 
        class="featured-card" 
        wx:for="{{item}}" 
        wx:for-item="work"
        wx:key="id"
        bindtap="onWorkTap"
        data-id="{{work.id}}"
      >
        <image class="featured-cover" src="{{work.coverUrl}}" mode="aspectFill" lazy-load="{{true}}" />
        <view class="featured-card-info">
          <text class="featured-card-title">{{work.title}}</text>
          <view class="featured-card-meta">
            <text class="meta-item" wx:if="{{work.categoryName}}">{{work.categoryName}}</text>
            <text class="meta-divider" wx:if="{{work.categoryName && work.subcategoryName}}">·</text>
            <text class="meta-item" wx:if="{{work.subcategoryName}}">{{work.subcategoryName}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore && !loading}}">
    <text>加载更多精选作品</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading && featuredWorks.length === 0}}">加载中...</view>
  
  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && featuredWorks.length === 0}}">
    <image src="/images/empty.png" mode="aspectFit" />
    <text>暂无精选作品</text>
  </view>

  <!-- 自定义底部导航 -->
  <view class="custom-tab-bar">
    <view class="tab-bar">
      <view class="tab-item" bindtap="switchTab" data-page="/pages/index/index">
        <image class="tab-icon" src="/images/home.png" mode="aspectFit"></image>
        <text class="tab-text">主页</text>
      </view>
      <view class="tab-item" bindtap="switchTab" data-page="/pages/customer/customer">
        <image class="tab-icon" src="/images/star.png" mode="aspectFit"></image>
        <text class="tab-text">{{albumName}}</text>
      </view>
      <view class="tab-item" bindtap="switchTab" data-page="/pages/contact/contact">
        <image class="tab-icon" src="/images/calendar.png" mode="aspectFit"></image>
        <text class="tab-text">联系我们</text>
      </view>
    </view>
  </view>
</view>
