<view class="container">
  <view class="contact-card">
    <view class="contact-header">
      <text class="contact-title">{{contactInfo.name || '畔黛造型'}}</text>
      <text class="contact-subtitle">{{contactInfo.description || '专业化妆造型服务'}}</text>
    </view>

    <view class="contact-info">
      <view class="info-item">
        <text class="info-label">联系电话</text>
        <text class="info-value" bindtap="onPhoneCall">{{contactInfo.phone}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">微信号</text>
        <text class="info-value" bindtap="onCopyWechat">{{contactInfo.wechat}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">地址</text>
        <text class="info-value">{{contactInfo.address}}</text>
      </view>
    </view>

    <button class="contact-btn" open-type="contact">
      联系客服
    </button>
  </view>

  <view class="admin-entry" wx:if="{{isAdmin}}" bindtap="goToAdmin">
    <text class="admin-icon">⚙️</text>
    <text class="admin-text">后台管理</text>
  </view>

  <view class="custom-tab-bar">
    <view class="tab-bar">
      <view class="tab-item" bindtap="switchTab" data-page="/pages/index/index">
        <image class="tab-icon" src="/images/home.png" mode="aspectFit"></image>
        <text class="tab-text">主页</text>
      </view>
      <view class="tab-item" bindtap="switchTab" data-page="/pages/customer/customer">
        <image class="tab-icon" src="/images/star.png" mode="aspectFit"></image>
        <text class="tab-text">美丽瞬间</text>
      </view>
      <view class="tab-item active">
        <image class="tab-icon" src="/images/calendar-active.png" mode="aspectFit"></image>
        <text class="tab-text active">联系我们</text>
      </view>
      <view class="tab-item" bindtap="switchTab" data-page="/pages/profile/profile">
        <image class="tab-icon" src="/images/profile.png" mode="aspectFit"></image>
        <text class="tab-text">我的</text>
      </view>
    </view>
  </view>
</view>
