.container {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding: 30rpx;
  box-sizing: border-box;
}

.contact-card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 2rpx 20rpx rgba(0, 0, 0, 0.05);
}

.contact-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.contact-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 10rpx;
}

.contact-subtitle {
  font-size: 24rpx;
  color: #999999;
  display: block;
}

.qrcode-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qrcode-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.qrcode-image {
  width: 400rpx;
  border-radius: 12rpx;
}

.empty-qrcode {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.contact-btn {
  width: 100%;
  height: 80rpx;
  background-color: #d4a574;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 40rpx;
  margin-top: 40rpx;
}

.admin-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  padding: 24rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.admin-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.admin-text {
  font-size: 28rpx;
  color: #666;
}
