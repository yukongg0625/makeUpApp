<view class="container">
  <!-- 用户信息区域 -->
  <view class="user-section">
    <block wx:if="{{isLoggedIn}}">
      <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
      <view class="user-info">
        <text class="nickname">{{userInfo.nickName}}</text>
        <text class="user-id">ID: {{userId}}</text>
      </view>
      <button class="logout-btn" bindtap="onLogout">退出登录</button>
    </block>
    <block wx:else>
      <view class="avatar-placeholder">👤</view>
      <view class="login-prompt">
        <text class="login-text">登录后可使用更多功能</text>
        <button class="login-btn" bindtap="onLogin">微信登录</button>
      </view>
    </block>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="onMenuTap" data-type="likes">
      <view class="menu-icon">❤️</view>
      <view class="menu-content">
        <text class="menu-title">我的点赞</text>
        <text class="menu-count">{{myLikes}}</text>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onMenuTap" data-type="comments">
      <view class="menu-icon">💬</view>
      <view class="menu-content">
        <text class="menu-title">我的评论</text>
        <text class="menu-count">{{myComments}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 关于区域 -->
  <view class="about-section">
    <view class="about-item" bindtap="onAboutTap">
      <view class="about-icon">ℹ️</view>
      <text class="about-text">关于我们</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>