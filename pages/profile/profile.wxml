<view class="container">
  <view class="user-section">
    <block wx:if="{{isLoggedIn}}">
      <image 
        class="avatar" 
        src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" 
        mode="aspectFill" 
      />
      <view class="right-section">
        <text class="nickname">{{userInfo.nickName || '微信用户'}}</text>
        <button class="logout-btn" bindtap="onLogout">退出登录</button>
      </view>
    </block>
    <block wx:else>
      <view class="login-container">
        <view class="login-left">
          <view class="avatar-circle-wrapper">
            <view class="avatar-circle">
              <image 
                class="avatar-preview" 
                src="{{tempAvatarUrl || '/images/default-avatar.png'}}" 
                mode="aspectFill"
              />
            </view>
            <button 
              class="avatar-btn-overlay" 
              open-type="chooseAvatar" 
              bind:chooseavatar="onChooseAvatar"
            ></button>
          </view>
          <text class="avatar-label">选择头像</text>
        </view>
        <view class="login-right">
          <view class="nickname-wrapper">
            <input 
              class="nickname-input" 
              type="nickname" 
              placeholder="请输入昵称" 
              bind:input="onNicknameInput"
              value="{{tempNickname}}"
            />
          </view>
          <button 
            class="login-btn" 
            bindtap="onLogin"
            disabled="{{!tempAvatarUrl || !tempNickname}}"
          >登录</button>
        </view>
      </view>
    </block>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="onMenuTap" data-type="favorites">
      <view class="menu-icon">⭐</view>
      <view class="menu-content">
        <text class="menu-title">我的收藏</text>
        <text class="menu-count">{{myFavorites}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="about-section">
    <view class="about-item" bindtap="onAboutTap">
      <view class="about-icon">ℹ️</view>
      <text class="about-text">关于我们</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>