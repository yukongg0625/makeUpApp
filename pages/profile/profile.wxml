<view class="container">
  <!-- 用户信息区域 -->
  <view class="user-section">
    <block wx:if="{{isLoggedIn}}">
      <image 
        class="avatar" 
        src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" 
        mode="aspectFill" 
      />
      <view class="user-info">
        <text class="nickname">{{userInfo.nickName || '微信用户'}}</text>
        <text class="user-id">ID: {{userId}}</text>
      </view>
      <button class="logout-btn" bindtap="onLogout">退出登录</button>
    </block>
    <block wx:else>
      <view class="login-form">
        <view class="avatar-upload">
          <button 
          class="avatar-button" 
          open-type="chooseAvatar" 
          bind:chooseavatar="onChooseAvatar"
        >
          <image 
            class="avatar-preview" 
            src="{{tempAvatarUrl || '/images/default-avatar.png'}}" 
            mode="aspectFill"
          ></image>
          <text class="avatar-hint">点击选择头像</text>
        </button>
        </view>
        <view class="nickname-input-wrapper">
          <input 
            class="nickname-input" 
            type="nickname" 
            placeholder="请输入昵称" 
            bind:input="onNicknameInput"
            value="{{tempNickname}}"
          />
        </view>
        <button 
          class="login-btn" 
          bindtap="onLogin"
          disabled="{{!tempAvatarUrl || !tempNickname}}"
        >登录</button>
      </view>
    </block>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="onMenuTap" data-type="likes">
      <view class="menu-icon">❤️</view>
      <view class="menu-content">
        <text class="menu-title">我的点赞</text>
        <text class="menu-count">{{myLikes}}</text>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onMenuTap" data-type="comments">
      <view class="menu-icon">💬</view>
      <view class="menu-content">
        <text class="menu-title">我的评论</text>
        <text class="menu-count">{{myComments}}</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 关于区域 -->
  <view class="about-section">
    <view class="about-item" bindtap="onAboutTap">
      <view class="about-icon">ℹ️</view>
      <text class="about-text">关于我们</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>