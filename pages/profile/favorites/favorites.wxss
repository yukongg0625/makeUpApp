/* pages/profile/favorites/favorites.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.page-header {
  padding: 40rpx 30rpx 30rpx;
  background-color: #fff;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 10rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: #999;
}

.favorites-grid {
  padding: 0 30rpx;
}

.favorites-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.favorite-item {
  width: 48%;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.cover-image {
  width: 100%;
  height: 400rpx;
  display: block;
}

.favorite-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
}

.favorite-title {
  font-size: 24rpx;
  color: #fff;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.loading {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-state {
  text-align: center;
  padding: 120rpx 30rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}