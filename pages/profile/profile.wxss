/* pages/profile/profile.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.user-section {
  background-color: #fff;
  padding: 60rpx 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 30rpx;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
  margin-right: 30rpx;
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: #999;
}

.logout-btn {
  padding: 16rpx 32rpx;
  background-color: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  border-radius: 32rpx;
  border: none;
}

.logout-btn::after {
  border: none;
}

.login-form {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-upload {
  margin-bottom: 40rpx;
  position: relative;
}

.avatar-button {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  overflow: hidden;
  line-height: 1;
}

.avatar-button::after {
  border: none;
}

.avatar-preview {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-hint {
  position: absolute;
  bottom: 10rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background-color: rgba(0, 0, 0, 0.5);
  padding: 4rpx 0;
  border-radius: 0 0 80rpx 80rpx;
}

.nickname-input-wrapper {
  width: 80%;
  margin-bottom: 40rpx;
}

.nickname-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.login-btn {
  padding: 20rpx 100rpx;
  background-color: #07c160;
  color: #fff;
  font-size: 30rpx;
  border-radius: 40rpx;
  border: none;
}

.login-btn[disabled] {
  background-color: #d1d1d1;
  color: #999;
}

.login-btn::after {
  border: none;
}

.login-prompt {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.login-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.menu-section {
  background-color: #fff;
  margin-bottom: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.menu-content {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.menu-title {
  font-size: 32rpx;
  color: #333;
}

.menu-count {
  font-size: 28rpx;
  color: #999;
}

.arrow {
  font-size: 40rpx;
  color: #ccc;
}

.about-section {
  background-color: #fff;
}

.about-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.about-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.about-text {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}