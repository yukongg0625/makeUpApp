<view class="container">
  <!-- 标题 -->
  <view class="page-header">
    <text class="header-title">{{albumName || '美丽瞬间'}}</text>
    <text class="header-subtitle">记录每一位顾客的美丽时刻</text>
  </view>

  <!-- 作品网格 -->
  <view class="photo-grid">
    <view class="photo-row" wx:for="{{photoRows}}" wx:key="index">
      <view 
        class="photo-item" 
        wx:for="{{item}}" 
        wx:for-item="photo"
        wx:key="_id"
        bindtap="onPhotoTap"
        data-id="{{photo._id}}"
      >
        <image class="photo-image" src="{{photo.imageUrl}}" mode="aspectFill" lazy-load="{{true}}" />
        <view class="photo-overlay" wx:if="{{photo.description}}">
          <text class="photo-desc">{{photo.description}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading && photos.length === 0}}">加载中...</view>
  
  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!loading && photos.length === 0}}">
    <text>暂无照片</text>
  </view>

  <view class="custom-tab-bar">
    <view class="tab-bar">
      <view class="tab-item" bindtap="switchTab" data-page="/pages/index/index">
        <image class="tab-icon" src="/images/home.png" mode="aspectFit"></image>
        <text class="tab-text">主页</text>
      </view>
      <view class="tab-item active">
        <image class="tab-icon" src="/images/star-active.png" mode="aspectFit"></image>
        <text class="tab-text active">{{albumName || '客照'}}</text>
      </view>
      <view class="tab-item" bindtap="switchTab" data-page="/pages/contact/contact">
        <image class="tab-icon" src="/images/calendar.png" mode="aspectFit"></image>
        <text class="tab-text">联系我们</text>
      </view>
      <view class="tab-item" bindtap="switchTab" data-page="/pages/profile/profile">
        <image class="tab-icon" src="/images/profile.png" mode="aspectFit"></image>
        <text class="tab-text">我的</text>
      </view>
    </view>
  </view>
</view>
