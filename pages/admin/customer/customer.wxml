<!--pages/admin/customer/customer.wxml-->
<view class="container">
  <!-- 顶部操作栏 -->
  <view class="header">
    <view class="title-section">
      <text class="title">{{albumName || '客照管理'}}</text>
      <view class="rename-btn" bindtap="onRenameAlbum">
        <text>改名</text>
      </view>
    </view>
    <view class="add-btn" bindtap="onAddPhoto">
      <text>+ 添加照片</text>
    </view>
  </view>

  <!-- 照片列表 -->
  <view class="list">
    <view class="list-item" wx:for="{{photos}}" wx:key="_id">
      <view class="item-cover">
        <image src="{{item.imageUrl}}" mode="aspectFill" />
        <view class="hidden-badge" wx:if="{{item.hidden}}">已隐藏</view>
      </view>
      <view class="item-info">
        <view class="item-desc-row">
          <text class="item-desc">{{item.description || '无描述'}}</text>
          <view class="status-tag {{item.hidden ? 'hidden' : 'visible'}}">
            <text>{{item.hidden ? '已隐藏' : '可见'}}</text>
          </view>
        </view>
        <text class="item-order">排序：{{item.order}}</text>
      </view>
      <view class="item-actions">
        <view class="action-btn edit" bindtap="onEditPhoto" data-id="{{item._id}}">编辑</view>
        <view class="action-btn delete" bindtap="onDeletePhoto" data-id="{{item._id}}">删除</view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{photos.length === 0}}">
    <text>暂无客照，请点击右上角添加</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>

<!-- 改名弹窗 -->
<view class="modal" wx:if="{{showRenameModal}}">
  <view class="modal-content rename-modal">
    <view class="modal-header">
      <text class="modal-title">修改相册名称</text>
      <text class="modal-close" bindtap="onCloseRenameModal">×</text>
    </view>
    <view class="modal-body">
      <view class="form-item">
        <text class="form-label">相册名称</text>
        <input class="form-input" value="{{newAlbumName}}" bindinput="onAlbumNameInput" placeholder="请输入相册名称" maxlength="20" />
      </view>
    </view>
    <view class="modal-footer">
      <view class="modal-btn cancel" bindtap="onCloseRenameModal">取消</view>
      <view class="modal-btn confirm" bindtap="onSaveAlbumName">保存</view>
    </view>
  </view>
</view>

<!-- 编辑弹窗 -->
<view class="modal" wx:if="{{showModal}}">
  <view class="modal-content">
    <view class="modal-header">
      <text class="modal-title">{{editMode ? '编辑客照' : '添加客照'}}</text>
      <text class="modal-close" bindtap="onCloseModal">×</text>
    </view>
    <scroll-view class="modal-body" scroll-y="{{true}}">
      <view class="form-item">
        <text class="form-label">照片</text>
        <view class="photo-preview" wx:if="{{formData.imageUrl}}">
          <image src="{{formData.imageUrl}}" mode="aspectFill" />
        </view>
        <view class="upload-btn" bindtap="onChooseImage">
          <text>{{formData.imageUrl ? '更换照片' : '选择照片'}}</text>
        </view>
      </view>
      <view class="form-item">
        <text class="form-label">描述</text>
        <textarea class="form-textarea" value="{{formData.description}}" bindinput="onDescInput" placeholder="请输入描述" />
      </view>
      <view class="form-item">
        <text class="form-label">排序</text>
        <input class="form-input" type="number" value="{{formData.order}}" bindinput="onOrderInput" placeholder="请输入排序号" />
      </view>
    </scroll-view>
    <view class="modal-footer">
      <view class="modal-btn cancel" bindtap="onCloseModal">取消</view>
      <view class="modal-btn confirm" bindtap="onSavePhoto">保存</view>
    </view>
  </view>
</view>