.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 100rpx;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #fff;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
}

.form-content {
  padding: 30rpx;
}

.form-item {
  background-color: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 12rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  font-size: 32rpx;
  color: #333;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}

.qrcode-area {
  width: 100%;
  height: 400rpx;
  background-color: #f9f9f9;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.qrcode-preview {
  width: 100%;
  height: 100%;
}

.qrcode-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  font-size: 80rpx;
  color: #ccc;
  line-height: 1;
  margin-bottom: 16rpx;
}

.placeholder-text {
  font-size: 26rpx;
  color: #999;
}

.qrcode-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.action-btn {
  flex: 1;
  height: 70rpx;
  background-color: #d4a574;
  color: #fff;
  border-radius: 35rpx;
  font-size: 26rpx;
  text-align: center;
  line-height: 70rpx;
}

.action-btn.delete {
  background-color: #ff6b6b;
}

.btn-area {
  padding: 30rpx;
}

.save-btn {
  background-color: #d4a574;
  color: #fff;
  padding: 28rpx;
  border-radius: 30rpx;
  font-size: 32rpx;
  text-align: center;
}
