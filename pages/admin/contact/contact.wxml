<view class="container">
  <view class="header">
    <text class="title">商家联系信息管理</text>
    <text class="subtitle">此处信息将展示给顾客，用于预约咨询</text>
  </view>

  <view class="form-content">
    <view class="form-item">
      <text class="form-label">公司名称</text>
      <input class="form-input" value="{{formData.name}}" bindinput="onNameInput" placeholder="请输入公司名称" />
    </view>

    <view class="form-item">
      <text class="form-label">服务简介</text>
      <input class="form-input" value="{{formData.description}}" bindinput="onDescriptionInput" placeholder="请输入服务简介" />
    </view>

    <view class="form-item">
      <text class="form-label">二维码图片</text>
      <view class="qrcode-area" bindtap="onChooseImage">
        <image wx:if="{{qrcodeUrl}}" class="qrcode-preview" src="{{qrcodeUrl}}" mode="aspectFit" />
        <view wx:else class="qrcode-placeholder">
          <text class="placeholder-icon">+</text>
          <text class="placeholder-text">点击上传二维码</text>
        </view>
      </view>
      <view class="qrcode-actions" wx:if="{{qrcodeUrl}}">
        <view class="action-btn" bindtap="onRechooseImage">重新选择</view>
        <view class="action-btn delete" bindtap="onRemoveImage">删除</view>
      </view>
    </view>
  </view>

  <view class="btn-area">
    <view class="save-btn" bindtap="onSave">保存</view>
  </view>
</view>
