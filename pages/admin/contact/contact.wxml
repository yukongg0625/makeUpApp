<!--pages/admin/contact/contact.wxml-->
<view class="container">
  <!-- 顶部操作栏 -->
  <view class="header">
    <text class="title">商家联系信息管理</text>
    <text class="subtitle">此处信息将展示给顾客，用于预约咨询</text>
  </view>

  <!-- 表单内容 -->
  <view class="form-content">
    <view class="form-item">
      <text class="form-label">公司名称</text>
      <input class="form-input" value="{{formData.name}}" bindinput="onNameInput" placeholder="请输入公司名称" />
    </view>

    <view class="form-item">
      <text class="form-label">服务简介</text>
      <input class="form-input" value="{{formData.description}}" bindinput="onDescriptionInput" placeholder="请输入服务简介" />
    </view>

    <view class="form-item">
      <text class="form-label">联系电话</text>
      <input class="form-input" type="number" value="{{formData.phone}}" bindinput="onPhoneInput" placeholder="请输入联系电话" />
    </view>

    <view class="form-item">
      <text class="form-label">微信号</text>
      <input class="form-input" value="{{formData.wechat}}" bindinput="onWechatInput" placeholder="请输入微信号" />
    </view>

    <view class="form-item">
      <text class="form-label">地址</text>
      <textarea class="form-textarea" value="{{formData.address}}" bindinput="onAddressInput" placeholder="请输入地址" />
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="btn-area">
    <view class="save-btn" bindtap="onSave">保存</view>
  </view>
</view>