<!--pages/admin/admin.wxml-->
<view class="container">
  <!-- 顶部标题 -->
  <view class="header">
    <text class="title">后台管理</text>
  </view>

  <!-- 管理菜单 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="onMenuTap" data-type="categories">
      <view class="menu-icon">📁</view>
      <view class="menu-content">
        <text class="menu-title">影集管理</text>
        <text class="menu-desc">管理影集名称和封面图片</text>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onMenuTap" data-type="subcategories">
      <view class="menu-icon">📂</view>
      <view class="menu-content">
        <text class="menu-title">子类管理</text>
        <text class="menu-desc">管理影集下的子类</text>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onMenuTap" data-type="works">
      <view class="menu-icon">🖼️</view>
      <view class="menu-content">
        <text class="menu-title">作品管理</text>
        <text class="menu-desc">管理作品图片和信息</text>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onMenuTap" data-type="featured">
      <view class="menu-icon">⭐</view>
      <view class="menu-content">
        <text class="menu-title">精华相册管理</text>
        <text class="menu-desc">管理精选作品</text>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onMenuTap" data-type="contact">
      <view class="menu-icon">📞</view>
      <view class="menu-content">
        <text class="menu-title">联系信息管理</text>
        <text class="menu-desc">编辑公司名称、电话、地址等信息</text>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onMenuTap" data-type="customer">
      <view class="menu-icon">📸</view>
      <view class="menu-content">
        <text class="menu-title">客照管理</text>
        <text class="menu-desc">管理顾客照片展示</text>
      </view>
      <text class="arrow">›</text>
    </view>

    <view class="menu-item" bindtap="onMenuTap" data-type="cleanup">
      <view class="menu-icon">🧹</view>
      <view class="menu-content">
        <text class="menu-title">清理孤立文件</text>
        <text class="menu-desc">删除未被引用的图片文件</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 版本号显示 -->
  <view class="version-info">
    <text class="version-text">版本号: {{version}}</text>
  </view>
</view>