/* pages/admin/works/works.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  background-color: #fff;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.header-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.add-btn {
  background-color: #d4a574;
  color: #fff;
  padding: 16rpx 32rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.add-btn.disabled {
  background-color: #ccc;
  color: #fff;
}

.current-path {
  display: flex;
  align-items: center;
}

.path-text {
  font-size: 24rpx;
  color: #999;
}

.filters {
  display: flex;
  background-color: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #eee;
  gap: 20rpx;
}

.filter-item {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
}

.filter-item text {
  font-size: 28rpx;
  color: #333;
}

.filter-item .arrow {
  font-size: 20rpx;
  color: #999;
}

.works-grid {
  padding: 20rpx;
}

.works-header {
  margin-bottom: 20rpx;
}

.works-count {
  font-size: 26rpx;
  color: #999;
}

.grid-container {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.grid-item {
  width: calc(33.33% - 14rpx);
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.work-cover {
  position: relative;
  width: 100%;
  padding-top: 100%;
}

.work-cover image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.cover-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  background-color: #d4a574;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.work-hidden-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.work-info {
  padding: 16rpx;
}

.work-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx;
  color: #999;
  font-size: 28rpx;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  height: 85vh;
  background-color: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
  flex-wrap: wrap;
  gap: 10rpx;
}

.modal-header-simple {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #333;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-path {
  flex: 1;
  text-align: left;
  font-size: 24rpx;
  color: #d4a574;
}

.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
  flex-shrink: 0;
}

.modal-body {
  padding: 30rpx;
  flex: 1;
  overflow-y: auto;
  min-height: 400rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.required {
  color: #ff4d4f;
  margin-left: 6rpx;
}

.form-hint {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 12rpx;
}

.toggle-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx solid #d4a574;
}

.toggle-btn text {
  font-size: 28rpx;
  color: #d4a574;
}

.toggle-btn.active {
  background-color: #d4a574;
}

.toggle-btn.active text {
  color: #fff;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 150rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker-input {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  height: 80rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.picker text {
  font-size: 28rpx;
  color: #333;
}

.picker.disabled {
  background-color: #e8e8e8;
  opacity: 0.7;
}

.picker.disabled text {
  color: #666;
}

.picker .arrow {
  font-size: 20rpx;
  color: #999;
}

.picker-input text {
  font-size: 28rpx;
  color: #333;
}

.picker-input .arrow {
  font-size: 20rpx;
  color: #999;
}

.featured-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 24rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx solid #d4a574;
}

.featured-btn text {
  font-size: 28rpx;
  color: #d4a574;
}

.featured-btn.featured {
  background-color: #d4a574;
}

.featured-btn.featured text {
  color: #fff;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}

.modal-btn {
  flex: 1;
  padding: 30rpx;
  text-align: center;
  font-size: 32rpx;
}

.modal-btn.cancel {
  color: #999;
  border-right: 1rpx solid #eee;
}

.modal-btn.delete-work {
  color: #ff4d4f;
  border-right: 1rpx solid #eee;
}

.modal-btn.delete-work.hidden {
  display: none;
}

.modal-btn.confirm {
  color: #d4a574;
  font-weight: bold;
}

.modal-btn.confirm.disabled {
  color: #ccc;
  background-color: #f5f5f5;
}

.photo-modal-content {
  width: 95%;
  max-height: 90vh;
  background-color: #1a1a1a;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.photo-list {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx;
}

.photo-item {
  background-color: #2a2a2a;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.photo-item image.photo-image {
  width: 100%;
  height: 400rpx;
  background-color: #000;
}

.photo-item-info {
  padding: 20rpx;
  border-bottom: 1rpx solid #3a3a3a;
}

.photo-item-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.photo-item-title {
  font-size: 28rpx;
  color: #fff;
}

.photo-item-type {
  font-size: 24rpx;
  color: #d4a574;
}

.status-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.status-tag.visible {
  background-color: #52c41a;
  color: #fff;
}

.status-tag.hidden {
  background-color: #ff4d4f;
  color: #fff;
}

.photo-item-actions {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 20rpx;
}

.photo-add-area {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx;
  border-top: 1rpx solid #333;
}

.photo-add-area text {
  color: #d4a574;
  font-size: 28rpx;
}

.photo-modal-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  border-top: 1rpx solid #333;
}

.photo-action-btn {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  background-color: #d4a574;
  color: #fff;
  border-radius: 30rpx;
  font-size: 28rpx;
}

.photo-action-btn.small {
  flex: 1;
  padding: 12rpx 16rpx;
  font-size: 22rpx;
}

.photo-action-btn.edit {
  background-color: #1890ff;
}

.photo-action-btn.delete {
  background-color: #ff4d4f;
}

.photo-preview image {
  width: 100%;
  height: 300rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
}

.images-upload-area {
  margin-top: 16rpx;
}

.upload-images-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.upload-image-item {
  position: relative;
  width: calc(33.33% - 12rpx);
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.upload-image-item image {
  width: 100%;
  height: 100%;
}

.upload-image-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  background-color: rgba(212, 165, 116, 0.9);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.upload-image-badge text {
  color: #fff;
  font-size: 22rpx;
}

.upload-image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #fff;
  font-size: 28rpx;
}

.upload-image-progress {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(0, 0, 0, 0.6);
  padding: 8rpx;
  text-align: center;
}

.upload-image-progress text {
  color: #fff;
  font-size: 22rpx;
}

.upload-add-btn {
  width: calc(33.33% - 12rpx);
  height: 200rpx;
  border: 2rpx dashed #d4a574;
  border-radius: 12rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.upload-add-btn text {
  color: #d4a574;
  font-size: 24rpx;
}

.upload-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
  display: block;
}